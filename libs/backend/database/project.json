{
  "root": "libs/backend/database",
  "sourceRoot": "libs/backend/database/src",
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/backend/database/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/libs/backend/database"],
      "options": {
        "jestConfig": "libs/backend/database/jest.config.js",
        "passWithNoTests": true
      }
    },
    "migration": {
      "executor": "nx:run-commands",
      "configurations": {
        "generate": {
          "forwardAllArgs": false,
          "commands": [
            "yarn run typeorm -d libs/backend/database/src/cli-data-source/{args.conn}.ts migration:generate libs/backend/database/src/lib/migrations/{args.conn}/{args.name}"
          ]
        },
        "run": {
          "forwardAllArgs": false,
          "commands": [
            "yarn run typeorm -d libs/backend/database/cli-data-source/{args.conn}.ts migration:run"
          ]
        },
        "revert": {
          "forwardAllArgs": false,
          "commands": [
            "yarn run typeorm -d libs/backend/database/cli-data-source/{args.conn}.ts migration:revert"
          ]
        }
      }
    },
    "typeorm": {
      "executor": "@nrwl/workspace:run-commands",
      "configurations": {
        "forwardAllArgs": false,
        "drop": {
          "commands": ["yarn run typeorm -d libs/backend/database/src/data-source.ts schema:drop"]
        },
        "log": {
          "commands": ["yarn run typeorm -d libs/backend/database/src/data-source.ts schema:log"]
        }
      }
    }
  },
  "tags": ["scope:backend", "scope:database", "type:lib"]
}
